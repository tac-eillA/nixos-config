usage() {
  cat >&2 <<'EOF'
usage: scylla-displayctl COMMAND [ARGUMENTS]

Commands:
  list
  refresh
  apply-profile NAME
  apply-profile-auto NAME
  save-profile NAME
  delete-profile NAME
  set OUTPUT enabled|mode|position|scale|transform|vrr|mirror VALUE
  cap-refresh OUTPUT MAX_HZ
  restore-refresh OUTPUT
  brightness-list
  brightness-set OUTPUT PERCENT
  persist-current
  confirm
  rollback
EOF
}

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_dir="$state_home/scylla-shell"
profile_dir="$state_dir/display-profiles"
shell_config="$config_home/scylla/shell.json"
monitor_config="$config_home/hypr/monitors.lua"
rollback_file="$state_dir/display-rollback.json"
rollback_unit_file="$state_dir/display-rollback-unit"
current_profile_file="$state_dir/display-profile"
self_path="$0"

mkdir -p "$state_dir" "$profile_dir" "$config_home/hypr"

require_hyprland() {
  if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    echo "Hyprland is not running" >&2
    exit 1
  fi
}

valid_profile_name() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

monitors_json() {
  require_hyprland
  hyprctl monitors all -j | jq '
    map({
      name: .name,
      description: (.description // .name),
      enabled: ((.disabled // false) | not),
      mode: (if (.disabled // false) then "preferred"
        else ((.width | tostring) + "x" + (.height | tostring) + "@"
          + ((.refreshRate // 60) | tostring)) end),
      position: (if (.disabled // false) then "auto"
        else ((.x | tostring) + "x" + (.y | tostring)) end),
      x: (.x // 0),
      y: (.y // 0),
      width: (.width // 0),
      height: (.height // 0),
      refreshRate: (.refreshRate // 0),
      scale: (.scale // 1),
      transform: (.transform // 0),
      vrr: (if (.vrr // false) == true then 1 else (.vrr // 0) end),
      mirror: ((.mirrorOf // "") | if . == "none" then "" else . end),
      focused: (.focused // false),
      availableModes: ((.availableModes // []) | map(sub("Hz$"; "")))
    })'
}

configured_internal_display() {
  if [ -r "$shell_config" ]; then
    jq -r '.internalDisplay // empty' "$shell_config" 2>/dev/null || true
  fi
}

is_internal_monitor() {
  local output="$1"
  local internal_display="$2"

  if [ -n "$internal_display" ]; then
    [ "$output" = "$internal_display" ]
    return
  fi

  case "$output" in
    eDP-*|LVDS-*|DSI-*) return 0 ;;
    *) return 1 ;;
  esac
}

backlight_device() {
  local path
  for path in /sys/class/backlight/*; do
    [ -e "$path" ] || continue
    basename "$path"
    return 0
  done
  return 1
}

# ddcutil's display numbers are session-local, so resolve them every time from
# the DRM connector reported by its verbose detector. The model fallback keeps
# this usable with ddcutil versions or drivers that omit the DRM connector.
ddc_records_json() {
  local detect_output
  if ! command -v ddcutil >/dev/null 2>&1; then
    printf '[]\n'
    return 0
  fi

  detect_output="$(timeout 5s ddcutil detect --verbose 2>/dev/null || true)"
  [ -n "$detect_output" ] || {
    printf '[]\n'
    return 0
  }

  printf '%s\n' "$detect_output" |
    awk '
      function reset() {
        display = "";
        bus = "";
        connector = "";
        mfg = "";
        model = "";
        serial = "";
      }
      function value_after_colon(line) {
        sub(/^[^:]*:[[:space:]]*/, "", line);
        return line;
      }
      function emit() {
        if (display == "") return;
        sub(/^card[0-9]+-/, "", connector);
        print display "\t" bus "\t" connector "\t" mfg "\t" model "\t" serial;
        reset();
      }
      BEGIN { reset() }
      /^[[:space:]]*Display[[:space:]]+[0-9]+/ {
        emit();
        display = $2;
        gsub(/[^0-9].*/, "", display);
        next;
      }
      /^[[:space:]]*I2C bus:/ {
        bus = $3;
        sub(/^\/dev\/i2c-/, "", bus);
        next;
      }
      /^[[:space:]]*DRM connector:/ { connector = $3; next }
      /^[[:space:]]*Mfg id:/ { mfg = value_after_colon($0); next }
      /^[[:space:]]*Model:/ { model = value_after_colon($0); next }
      /^[[:space:]]*Serial number:/ { serial = value_after_colon($0); next }
      END { emit() }
    ' |
    while IFS=$'\t' read -r display bus connector mfg model serial; do
      [ -n "$display" ] || continue
      jq -n \
        --arg display "$display" \
        --arg bus "$bus" \
        --arg connector "$connector" \
        --arg mfg "$mfg" \
        --arg model "$model" \
        --arg serial "$serial" \
        '{display: ($display | tonumber), bus: $bus, connector: $connector,
          mfg: $mfg, model: $model, serial: $serial}'
    done |
    jq -s '.'
}

ddc_display_for_monitor() {
  local monitor_name="$1"
  local monitor_description="$2"
  local ddc_records="$3"

  jq -r \
    --arg name "$monitor_name" \
    --arg description "$monitor_description" \
    'first(.[] | . as $display
      | select($display.connector == $name
        or ($display.model != ""
          and ($description | contains($display.model))))
      | (.display | tostring)) // empty' \
    <<<"$ddc_records"
}

ddc_monitor_identifier() {
  local display_number="$1"
  local ddc_records="$2"

  jq -r --argjson display "$display_number" \
    'first(.[] | select(.display == $display)
      | if .serial != "" then
          ([.mfg, .model, .serial] | map(select(length > 0)) | join(":"))
        else ([.mfg, .model] | map(select(length > 0)) | join(":"))
        end) // empty' \
    <<<"$ddc_records"
}

brightness_record() {
  local monitor_json="$1"
  local ddc_records="$2"
  local name description enabled internal_display device info value maximum
  local display_number vcp_output vcp_values identifier backend reason
  local supported=false

  name="$(jq -r '.name // empty' <<<"$monitor_json")"
  description="$(jq -r '.description // .name // empty' <<<"$monitor_json")"
  enabled="$(jq -r 'if .enabled == false then "false" else "true" end' <<<"$monitor_json")"
  internal_display="$(configured_internal_display)"
  backend="none"
  identifier="$description"
  reason="Brightness control unavailable"
  value=0
  maximum=100

  if is_internal_monitor "$name" "$internal_display"; then
    backend="backlight"
    device="$(backlight_device || true)"
    identifier="$device"
    if [ "$enabled" = true ] && [ -n "$device" ]; then
      info="$(brightnessctl -m -d "$device" info 2>/dev/null || true)"
      value="$(awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }' <<<"$info")"
      if [[ "$value" =~ ^[0-9]+$ ]]; then
        supported=true
        reason=""
      else
        value=0
        reason="Unable to read the backlight"
      fi
    elif [ "$enabled" != true ]; then
      reason="Display is disabled"
    else
      reason="No backlight device found"
    fi
  elif [ "$enabled" = true ]; then
    backend="ddc"
    display_number="$(ddc_display_for_monitor "$name" "$description" "$ddc_records")"
    if [ -n "$display_number" ]; then
      identifier="$(ddc_monitor_identifier "$display_number" "$ddc_records")"
      [ -n "$identifier" ] || identifier="$description"
      vcp_output="$(timeout 3s ddcutil getvcp 10 --display "$display_number" --brief 2>/dev/null || true)"
      vcp_values="$(awk '$1 == "VCP" && toupper($2) == "10" && $3 == "C" { print $4, $5; exit }' <<<"$vcp_output")"
      value="${vcp_values%% *}"
      maximum="${vcp_values#* }"
      if [[ "$value" =~ ^[0-9]+$ ]] && [[ "$maximum" =~ ^[0-9]+$ ]] && [ "$maximum" -gt 0 ]; then
        value=$((value * 100 / maximum))
        maximum=100
        supported=true
        reason=""
      else
        value=0
        maximum=100
        reason="Monitor does not expose DDC/CI brightness"
      fi
    else
      reason="Monitor was not found by DDC/CI"
    fi
  else
    backend="ddc"
    reason="Display is disabled"
  fi

  jq -n \
    --arg name "$name" \
    --arg backend "$backend" \
    --arg identifier "$identifier" \
    --arg reason "$reason" \
    --argjson supported "$supported" \
    --argjson value "${value:-0}" \
    --argjson maximum "${maximum:-100}" \
    '{name: $name, supported: $supported, value: $value, maximum: $maximum,
      backend: $backend, identifier: $identifier, reason: $reason}'
}

brightness_list_json() {
  local monitors="$1"
  local ddc_records="$2"
  local monitor
  local -a records=()

  while IFS= read -r monitor; do
    [ -n "$monitor" ] || continue
    records+=("$(brightness_record "$monitor" "$ddc_records")")
  done < <(jq -c '.[]' <<<"$monitors")

  if [ "${#records[@]}" -eq 0 ]; then
    printf '[]\n'
  else
    printf '%s\n' "${records[@]}" | jq -s '.'
  fi
}

brightness_set() {
  local output="$1"
  local percent="$2"
  local monitors monitor description enabled internal_display device
  local ddc_records display_number vcp_output vcp_values maximum target

  if ! [[ "$percent" =~ ^[0-9]+$ ]] || [ "$percent" -gt 100 ]; then
    echo "Brightness must be an integer from 0 to 100" >&2
    return 2
  fi

  monitors="$(monitors_json)"
  monitor="$(jq -c --arg output "$output" 'first(.[] | select(.name == $output)) // empty' <<<"$monitors")"
  [ -n "$monitor" ] || {
    echo "Unknown output: $output" >&2
    return 1
  }

  enabled="$(jq -r 'if .enabled == false then "false" else "true" end' <<<"$monitor")"
  [ "$enabled" = true ] || {
    echo "Cannot change brightness for disabled output: $output" >&2
    return 1
  }

  internal_display="$(configured_internal_display)"
  if is_internal_monitor "$output" "$internal_display"; then
    device="$(backlight_device || true)"
    [ -n "$device" ] || {
      echo "No backlight device found for $output" >&2
      return 1
    }
    brightnessctl -q -n 0 -d "$device" set "${percent}%"
    return 0
  fi

  description="$(jq -r '.description // .name // empty' <<<"$monitor")"
  ddc_records="$(ddc_records_json)"
  display_number="$(ddc_display_for_monitor "$output" "$description" "$ddc_records")"
  [ -n "$display_number" ] || {
    echo "Monitor $output does not expose a usable DDC/CI brightness control" >&2
    return 1
  }

  vcp_output="$(timeout 3s ddcutil getvcp 10 --display "$display_number" --brief 2>/dev/null || true)"
  vcp_values="$(awk '$1 == "VCP" && toupper($2) == "10" && $3 == "C" { print $4, $5; exit }' <<<"$vcp_output")"
  maximum="${vcp_values#* }"
  [[ "$maximum" =~ ^[0-9]+$ ]] && [ "$maximum" -gt 0 ] || {
    echo "Monitor $output does not expose DDC/CI brightness VCP 0x10" >&2
    return 1
  }
  target=$((percent * maximum / 100))
  timeout 5s ddcutil setvcp 10 "$target" --display "$display_number" --noverify
}

profiles_json() {
  local profiles profile_file profile_name
  if [ -r "$shell_config" ]; then
    profiles="$(jq -c '.displayProfiles // {}' "$shell_config")"
  else
    profiles='{}'
  fi

  shopt -s nullglob
  for profile_file in "$profile_dir"/*.json; do
    profile_name="$(basename "$profile_file" .json)"
    profiles="$(jq -c --arg name "$profile_name" --slurpfile rules "$profile_file" \
      '. + {($name): $rules[0]}' <<<"$profiles")"
  done
  shopt -u nullglob
  printf '%s\n' "$profiles"
}

validate_layout() {
  jq -e '
    type == "array"
    and length > 0
    and ([.[] | select(.enabled != false)] | length > 0)
    and ([.[].name] | length == (unique | length))
    and all(.[];
      (.name | type == "string" and length > 0)
      and ((.scale // 1) | type == "number" and . > 0)
      and ((.transform // 0) | type == "number" and . >= 0 and . <= 7)
      and ((.vrr // 0) | type == "number" and . >= 0 and . <= 3))
    and all(.[] as $monitor;
      (($monitor.mirror // "") == "")
      or (($monitor.mirror != $monitor.name)
        and any(.[]; .name == $monitor.mirror and .enabled != false)))
  ' >/dev/null
}

render_lua() {
  jq -r '
    .[] |
    if .enabled == false then
      "hl.monitor({ output = \(.name | @json), disabled = true })"
    else
      "hl.monitor({ output = \(.name | @json), mode = \((.mode // \"preferred\") | @json), position = \((.position // \"auto\") | @json), scale = \(.scale // 1), transform = \(.transform // 0), vrr = \(.vrr // 0)"
      + (if (.mirror // "") == "" then "" else ", mirror = \(.mirror | @json)" end)
      + " })"
    end'
}

persist_layout() {
  local layout_file="$1"
  local monitor_tmp="$monitor_config.tmp"
  render_lua <"$layout_file" >"$monitor_tmp"
  if [ ! -s "$monitor_tmp" ]; then
    rm -f "$monitor_tmp"
    echo "Refusing to persist an empty monitor configuration" >&2
    return 1
  fi
  mv "$monitor_tmp" "$monitor_config"
}

apply_layout_file() {
  local layout_file="$1"
  local rule
  validate_layout <"$layout_file" || {
    echo "Invalid display layout" >&2
    return 1
  }

  while IFS= read -r rule; do
    hyprctl keyword monitor "$rule" >/dev/null
  done < <(jq -r '
    .[] |
    if .enabled == false then
      .name + ",disable"
    else
      .name + "," + (.mode // "preferred") + ","
      + (.position // "auto") + "," + ((.scale // 1) | tostring)
      + ",transform," + ((.transform // 0) | tostring)
      + ",vrr," + ((.vrr // 0) | tostring)
      + (if (.mirror // "") == "" then "" else ",mirror," + .mirror end)
    end' "$layout_file")
}

cancel_rollback_timer() {
  local rollback_unit
  if [ -r "$rollback_unit_file" ]; then
    rollback_unit="$(cat "$rollback_unit_file")"
    systemctl --user stop "$rollback_unit.timer" "$rollback_unit.service" >/dev/null 2>&1 || true
    rm -f "$rollback_unit_file"
  fi
}

schedule_rollback() {
  local rollback_unit
  cancel_rollback_timer
  rollback_unit="scylla-display-rollback-$(date +%s%N)"
  systemd-run --user --quiet \
    --unit "$rollback_unit" \
    --on-active=20s \
    --timer-property=AccuracySec=1s \
    --property=CollectMode=inactive-or-failed \
    "$self_path" rollback
  printf '%s\n' "$rollback_unit" >"$rollback_unit_file"
}

begin_transaction() {
  if [ ! -r "$rollback_file" ]; then
    monitors_json >"$rollback_file"
  fi
}

finish_runtime_apply() {
  local current_tmp="$state_dir/current-displays.json.tmp"
  monitors_json >"$current_tmp"
  persist_layout "$current_tmp"
  mv "$current_tmp" "$state_dir/current-displays.json"
  schedule_rollback
}

transactional_apply() {
  local layout_file="$1"
  begin_transaction
  if ! apply_layout_file "$layout_file"; then
    apply_layout_file "$rollback_file" || true
    persist_layout "$rollback_file" || true
    rm -f "$rollback_file"
    return 1
  fi
  finish_runtime_apply
}

profile_rules() {
  local profile_name="$1"
  local custom_profile="$profile_dir/$profile_name.json"
  if [ -r "$custom_profile" ]; then
    jq -c '.' "$custom_profile"
  elif [ -r "$shell_config" ]; then
    jq -ce --arg name "$profile_name" '.displayProfiles[$name]' "$shell_config"
  else
    return 1
  fi
}

normalize_profile() {
  jq 'map({
    name: .output,
    description: .output,
    enabled: (.enabled // true),
    mode: (.mode // "preferred"),
    position: (.position // "auto"),
    scale: (.scale // 1),
    transform: (.transform // 0),
    vrr: (.vrr // 0),
    mirror: (.mirror // ""),
    availableModes: []
  })'
}

command="${1:-}"
case "$command" in
  list|refresh)
    monitors="$(monitors_json)"
    profiles="$(profiles_json)"
    current_profile=""
    if [ -r "$current_profile_file" ]; then
      current_profile="$(cat "$current_profile_file")"
    fi
    jq -n \
      --argjson monitors "$monitors" \
      --argjson profiles "$profiles" \
      --arg currentProfile "$current_profile" \
      --argjson confirmationPending "$([ -r "$rollback_file" ] && echo true || echo false)" \
      '{monitors: $monitors, profiles: $profiles, currentProfile: $currentProfile,
        confirmationPending: $confirmationPending}'
    ;;

  brightness-list)
    [ "$#" -eq 1 ] || {
      usage
      exit 2
    }
    current_monitors="$(monitors_json)"
    current_ddc_records="$(ddc_records_json)"
    brightness_list_json "$current_monitors" "$current_ddc_records"
    ;;

  brightness-set)
    [ "$#" -eq 3 ] || {
      usage
      exit 2
    }
    brightness_set "$2" "$3"
    ;;

  persist-current)
    [ "$#" -eq 1 ] || {
      usage
      exit 2
    }
    current_tmp="$state_dir/current-displays.json.tmp"
    monitors_json >"$current_tmp"
    persist_layout "$current_tmp"
    mv "$current_tmp" "$state_dir/current-displays.json"
    ;;

  apply-profile|apply-profile-auto)
    if [ "$#" -ne 2 ] || ! valid_profile_name "$2"; then
      usage
      exit 2
    fi
    layout_tmp="$state_dir/apply-profile.json.tmp"
    profile_tmp="$state_dir/apply-profile-rules.json.tmp"
    profile_rules "$2" | normalize_profile >"$profile_tmp" || {
      rm -f "$layout_tmp" "$profile_tmp"
      echo "Unknown display profile: $2" >&2
      exit 1
    }
    monitors_json | jq --slurpfile configured "$profile_tmp" '
      . as $current | $configured[0] as $rules |
      $rules + [$current[]
        | select(.name as $name | any($rules[]; .name == $name) | not)
        | .enabled = false]' >"$layout_tmp"
    transactional_apply "$layout_tmp"
    rm -f "$layout_tmp" "$profile_tmp"
    printf '%s\n' "$2" >"$current_profile_file"
    if [ "$command" = apply-profile-auto ]; then
      cancel_rollback_timer
      rm -f "$rollback_file"
    fi
    ;;

  save-profile)
    if [ "$#" -ne 2 ] || ! valid_profile_name "$2"; then
      usage
      exit 2
    fi
    profile_tmp="$profile_dir/$2.json.tmp"
    monitors_json | jq 'map({
      output: .name,
      enabled,
      mode,
      position,
      scale,
      transform,
      vrr,
      mirror: (if .mirror == "" then null else .mirror end)
    })' >"$profile_tmp"
    mv "$profile_tmp" "$profile_dir/$2.json"
    printf '%s\n' "$2" >"$current_profile_file"
    ;;

  delete-profile)
    if [ "$#" -ne 2 ] || ! valid_profile_name "$2"; then
      usage
      exit 2
    fi
    if [ ! -e "$profile_dir/$2.json" ]; then
      echo "Only mutable display profiles can be deleted: $2" >&2
      exit 1
    fi
    rm "$profile_dir/$2.json"
    if [ -r "$current_profile_file" ] && [ "$(cat "$current_profile_file")" = "$2" ]; then
      rm -f "$current_profile_file"
    fi
    ;;

  set)
    [ "$#" -eq 4 ] || {
      usage
      exit 2
    }
    output="$2"
    field="$3"
    value="$4"
    current_tmp="$state_dir/set-display.json.tmp"
    monitors_json >"$current_tmp"
    jq -e --arg output "$output" 'any(.[]; .name == $output)' "$current_tmp" >/dev/null || {
      rm -f "$current_tmp"
      echo "Unknown output: $output" >&2
      exit 1
    }
    case "$field" in
      enabled)
        [ "$value" = true ] || [ "$value" = false ] || exit 2
        jq --arg output "$output" --argjson value "$value" \
          'map(if .name == $output then .enabled = $value else . end)' \
          "$current_tmp" >"$current_tmp.next"
        ;;
      mode|position|mirror)
        jq --arg output "$output" --arg field "$field" --arg value "$value" \
          'map(if .name == $output then .[$field] = $value else . end)' \
          "$current_tmp" >"$current_tmp.next"
        ;;
      scale)
        jq -en --arg value "$value" '$value | tonumber | select(. > 0)' >/dev/null
        jq --arg output "$output" --argjson value "$value" \
          'map(if .name == $output then .scale = $value else . end)' \
          "$current_tmp" >"$current_tmp.next"
        ;;
      transform)
        jq -en --arg value "$value" '$value | tonumber | select(. >= 0 and . <= 7)' >/dev/null
        jq --arg output "$output" --argjson value "$value" \
          'map(if .name == $output then .transform = $value else . end)' \
          "$current_tmp" >"$current_tmp.next"
        ;;
      vrr)
        jq -en --arg value "$value" '$value | tonumber | select(. >= 0 and . <= 3)' >/dev/null
        jq --arg output "$output" --argjson value "$value" \
          'map(if .name == $output then .vrr = $value else . end)' \
          "$current_tmp" >"$current_tmp.next"
        ;;
      *)
        rm -f "$current_tmp"
        usage
        exit 2
        ;;
    esac
    mv "$current_tmp.next" "$current_tmp"
    transactional_apply "$current_tmp"
    rm -f "$current_tmp" "$current_profile_file"
    ;;

  cap-refresh)
    [ "$#" -eq 3 ] || {
      usage
      exit 2
    }
    jq -en --arg value "$3" '$value | tonumber | select(. > 0)' >/dev/null
    current_tmp="$state_dir/cap-refresh.json.tmp"
    original_refresh_file="$state_dir/adaptive-refresh-original.json"
    current_layout="$(monitors_json)"
    if ! jq -e --arg output "$2" 'has($output)' "$original_refresh_file" >/dev/null 2>&1; then
      original_mode="$(jq -er --arg output "$2" '.[] | select(.name == $output) | .mode' \
        <<<"$current_layout")" || original_mode=""
      if [ -n "$original_mode" ]; then
        if [ -r "$original_refresh_file" ]; then
          jq --arg output "$2" --arg mode "$original_mode" '. + {($output): $mode}' \
            "$original_refresh_file" >"$original_refresh_file.tmp"
        else
          jq -n --arg output "$2" --arg mode "$original_mode" '{($output): $mode}' \
            >"$original_refresh_file.tmp"
        fi
        mv "$original_refresh_file.tmp" "$original_refresh_file"
      fi
    fi
    jq --arg output "$2" --argjson maximum "$3" '
      map(if .name != $output or .enabled == false then . else
        . as $monitor |
        ([.availableModes[]
          | capture("^(?<width>[0-9]+)x(?<height>[0-9]+)@(?<rate>[0-9.]+)")
          | .width = (.width | tonumber)
          | .height = (.height | tonumber)
          | .rate = (.rate | tonumber)
          | select(.width == $monitor.width and .height == $monitor.height and .rate <= $maximum)]
          | sort_by(.rate) | last) as $mode |
        if $mode == null then . else
          .mode = (($mode.width | tostring) + "x" + ($mode.height | tostring)
            + "@" + ($mode.rate | tostring))
        end
      end)' <<<"$current_layout" >"$current_tmp"
    transactional_apply "$current_tmp"
    cancel_rollback_timer
    rm -f "$rollback_file"
    rm -f "$current_tmp" "$current_profile_file"
    ;;

  restore-refresh)
    [ "$#" -eq 2 ] || {
      usage
      exit 2
    }
    original_refresh_file="$state_dir/adaptive-refresh-original.json"
    if [ ! -r "$original_refresh_file" ] \
      || ! original_mode="$(jq -er --arg output "$2" '.[$output]' "$original_refresh_file")"; then
      exit 0
    fi
    current_tmp="$state_dir/restore-refresh.json.tmp"
    monitors_json | jq --arg output "$2" --arg mode "$original_mode" \
      'map(if .name == $output then .mode = $mode else . end)' >"$current_tmp"
    transactional_apply "$current_tmp"
    cancel_rollback_timer
    rm -f "$rollback_file"
    jq --arg output "$2" 'del(.[$output])' "$original_refresh_file" \
      >"$original_refresh_file.tmp"
    if jq -e 'length == 0' "$original_refresh_file.tmp" >/dev/null; then
      rm -f "$original_refresh_file" "$original_refresh_file.tmp"
    else
      mv "$original_refresh_file.tmp" "$original_refresh_file"
    fi
    rm -f "$current_tmp" "$current_profile_file"
    ;;

  confirm)
    cancel_rollback_timer
    rm -f "$rollback_file"
    ;;

  rollback)
    cancel_rollback_timer
    if [ -r "$rollback_file" ]; then
      apply_layout_file "$rollback_file"
      persist_layout "$rollback_file"
      mv "$rollback_file" "$state_dir/current-displays.json"
    fi
    rm -f "$current_profile_file"
    ;;

  *)
    usage
    exit 2
    ;;
esac
